# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FOLLOWSPANEL_API_KEY: Server-side FollowSPanel API Key for SMM Boosting.
FOLLOWSPANEL_API_KEY=""

# CARTLOGS_API_KEY: Server-side Cartlogs API Key for Social Media Account Logs.
# Production Endpoint: https://api.cartlogs.com/api/v1/
# Required for all Cartlogs product catalog fetching, account orders, and status requests.
CARTLOGS_API_KEY=""

# CARTLOGS_WEBHOOK_SECRET: (Optional) Secret for verifying X-Cartlogs-Signature HMAC-SHA256
# Leave empty if webhook is not configured. Normal Cartlogs API functions operate with CARTLOGS_API_KEY alone.
CARTLOGS_WEBHOOK_SECRET=""

# PAYSTACK_SECRET_KEY: Server-side Paystack Secret Key for payment verification (sk_test_... or sk_live_...)
# Stored securely on the server only. Never exposed to the frontend.
PAYSTACK_SECRET_KEY=""

# INSTANTNUMS_API_KEY (or INSTANTNUM_API_KEY): Server-side InstantNums API Key for SMS Verification Numbers.
# Production Endpoint: https://instantnums.com/v1
# Stored strictly on the server side. NEVER exposed to frontend or in VITE_* variables.
INSTANTNUMS_API_KEY=""
INSTANTNUM_API_KEY=""
INSTANTNUMS_BASE_URL="https://instantnums.com/v1"
INSTANTNUM_BASE_URL="https://instantnums.com/v1"
INSTANTNUMS_USD_TO_NGN_RATE="1600.00"
INSTANTNUMS_MARKUP_BELOW_1000_NGN="1000"
INSTANTNUMS_MARKUP_1000_AND_ABOVE_NGN="2000"

# VITE_PAYSTACK_PUBLIC_KEY: Frontend Paystack Public Key for checkout popup (pk_test_... for Test Mode)
VITE_PAYSTACK_PUBLIC_KEY="pk_test_c6a989fa162d6563a2e53015cd6cf15570f68d8f"
