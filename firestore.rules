rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'chinonsochinix@gmail.com' ||
        request.auth.token.email == 'comedyhome0@gmail.com' ||
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users collection
    match /users/{userId} {
      // User can read their own profile; Admin can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // User can create their initial profile during registration
      allow create: if isOwner(userId) && (
        isAdmin() || (
          request.resource.data.role == 'user' &&
          request.resource.data.balance == 0
        )
      );

      // Users can only update non-sensitive profile fields (full_name, phone, welcome_seen)
      // Sensitive fields (balance, role, referral_code, referral_qualified, successful_purchases_count) are immutable by normal users
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'balance', 
          'role', 
          'referral_code', 
          'referral_qualified', 
          'referralQualified',
          'successful_purchases_count',
          'successfulPurchaseCount',
          'referral_balance',
          'referral_earnings'
        ])
      );

      allow delete: if isAdmin();
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow write: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      // Created through verified checkout or admin
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Deposits collection
    match /deposits/{depositId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      // User can submit a pending deposit
      allow create: if isAuthenticated() && 
        (request.resource.data.status == 'pending' || request.resource.data.status == 'Pending');
      // Only admin can approve or reject deposits
      allow update, delete: if isAdmin();
    }

    // Transactions Ledger
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.user_id == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Custom Website Requests
    match /custom_orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.user_id == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Referrals records
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        resource.data.referrer_id == request.auth.uid || 
        resource.data.referrerUserId == request.auth.uid || 
        resource.data.referred_id == request.auth.uid || 
        resource.data.referredUserId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Referral Rewards
    match /referral_rewards/{rewardId} {
      allow read: if isAuthenticated() && (
        resource.data.referrer_id == request.auth.uid || 
        resource.data.referrerUserId == request.auth.uid || 
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // Support tickets
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.user_id == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // System settings
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reseller API profiles & configurations
    match /resellers/{resellerId} {
      allow read: if isOwner(resellerId) || isAdmin();
      allow write: if isOwner(resellerId) || isAdmin();
    }

    // Reseller API Orders
    match /reseller_orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.reseller_id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Reseller API Audit Logs
    match /reseller_logs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.reseller_id == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }
  }
}
